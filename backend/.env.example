# MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=

# 32-byte key for AES-256-GCM address field encryption — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Fatura e-postası — Brevo (https://www.brevo.com → SMTP & API → API keys → v3 key = xkeysib-...)
BREVO_API_KEY=xkeysib_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brevo’da doğrulanmış gönderen e-postası (Campaigns → Senders veya Transactional için eklediğin adres)
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# İsteğe bağlı gönderen görünen adı
BREVO_SENDER_NAME=SCYLLA Store
